CXX_STD = CXX20

PKG_CPPFLAGS = -I. \
							 -DTRUE=(Rboolean)1 -DFALSE=(Rboolean)0 \
               @RAMIGA_INCLUDES@ @RAMIGA_FLAGS@

PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) @PKG_LIBS_EXTRA@

CFILES = @RAMIGA_CFILES@
CPPFILES = @RAMIGA_CPPFILES@

SOURCES = $(CFILES) $(CPPFILES)

OBJECTS = $(CFILES:.c=.o) $(CPPFILES:.cpp=.o)
